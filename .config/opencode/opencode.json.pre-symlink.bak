{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers"],
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "autoupdate": false,
  "model": "ollama/glm-5.1:cloud",
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "find *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git status": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "tree *": "allow"
    },
    "edit": "ask",
    "webfetch": "ask"
  },
  "provider": {
    "ollama": {
      "models": {
        "gemma4": {
          "_launch": true,
          "name": "gemma4"
        },
        "gemma4-coding": {
          "_launch": true,
          "name": "gemma4-coding"
        },
        "glm-5.1:cloud": {
          "_launch": true,
          "name": "glm-5.1:cloud"
        },
        "qwen3.5": {
          "_launch": true,
          "name": "qwen3.5"
        },
        "qwen3.5-coding": {
          "_launch": true,
          "name": "qwen3.5-coding"
        },
        "ornith-oc": {
          "_launch": true,
          "name": "ornith-oc"
        },
        "ornith-engineer": {
          "_launch": true,
          "name": "ornith-engineer"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}

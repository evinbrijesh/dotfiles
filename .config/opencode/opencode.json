{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers"],
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "autoupdate": false,
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "find *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git status": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "tree *": "allow"
    },
    "edit": "ask",
    "webfetch": "ask"
  },
  "provider": {
    "ollama": {
      "models": {
        "qwen3.5-coding:latest": {
  "name": "Qwen 3.5 9B Coding (32K)",
  "limit": {
    "context": 32768,
    "output": 4096
  },
  "options": {
    "reasoningEffort": "none"
  }
},
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B (32K)",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "hf.co/HauhauCS/Gemma-4-E4B-Uncensored-HauhauCS-Aggressive:Q5_K_M": {
          "name": "Gemma 4 E4B (32K)",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "gemma4-coding:latest": {
          "name": "Gemma 4 Coding (32K)",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "opencode-engineer:latest": {
          "name": "OpenCode Engineer (32K)",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}
